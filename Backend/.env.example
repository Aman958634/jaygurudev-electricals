PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jaygurudev_db
ADMIN_EMAIL=admin@jaygurudev.com
ADMIN_PASSWORD=
# Keep mutable data outside an Ubuntu release directory in production.
# Local development continues to use Backend/uploads and Backend/private-imports.
UPLOAD_STORAGE_ROOT=
IMPORT_STORAGE_ROOT=
# Maximum CSV/XLSX/ZIP/PDF import request size in MiB (default 50; maximum 250).
IMPORT_MAX_ZIP_MB=50
# OCR worker count for PDF imports. Leave empty to use a CPU-aware default.
PDF_OCR_CONCURRENCY=
# Optional persistent Tesseract cache/language-data locations for scanned PDFs.
# Startup does not require them; configure a writable cache before first OCR.
OCR_CACHE_PATH=
OCR_LANG_PATH=
